<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
	<!-- General -->
	<category label="General">
		<setting id="service_enabled" type="bool" label="Enable background service" default="true"/>
		<setting id="debug" type="bool" label="Enable debug logging" default="false"/>
		<setting id="artwork_cache_enabled" type="bool" label="Pre-cache widget artwork" default="true"/>
	</category>

	<!-- Fanart Settings -->
	<category label="Background Fanart">
		<setting id="fanart_enabled" type="bool" label="Enable fanart rotation" default="true"/>
		<setting id="fanart_interval" type="number" label="Rotation interval (seconds)" default="30"/>
		<setting type="lsep" label="Include categories:"/>
		<setting id="fanart_movies" type="bool" label="Movies" default="true"/>
		<setting id="fanart_tvshows" type="bool" label="TV Shows" default="true"/>
		<setting id="fanart_music" type="bool" label="Music Artists" default="true"/>
	</category>

	<category label="Widget Behavior">
        <setting id="recentlyadded.navigation" type="labelenum" label="Recently Added Navigation" values="Browse|First Episode" default="Browse"/>
    </category>

	<category label="Sonarr Integration">
		<setting id="sonarr.enabled" type="bool" label="Enable Sonarr" default="false"/>
		<setting id="sonarr.url" type="text" label="Sonarr URL" default="http://localhost:8989"/>
		<setting id="sonarr.apikey" type="text" label="Sonarr API Key"/>
		<setting id="sonarr.days" type="slider" label="Days Ahead" default="7" range="1,30"/>
	</category>
</settings>
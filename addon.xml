<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.flatscan.widgets" 
       name="Flatscan Widgets" 
       version="1.0.0" 
       provider-name="flatscan">
    
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.pil" version="5.1.0"/>
    </requires>
    
    <!-- Script interface (for skin calls) -->
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    
    <!-- Plugin interface (for widgets) -->
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>video</provides>
    </extension>
    
    <!-- Service interface (for background tasks) -->
    <extension point="xbmc.service" library="service.py"/>
    
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Flatscan Widgets for Kodi</summary>
        <description lang="en_GB">Modern widget and helper addon for Kodi skins. 
Provides in-progress content, next-up episodes, similar items, 
background blur effects, and more.</description>
        
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <source>https://github.com/flatscan/flatscanwidgets</source>
        <forum>https://github.com/flatscan/flatscanwidgets/discussions</forum>
        
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
        
        <!-- Mark as compatible with Kodi 20+ -->
        <news>v1.0.0 (2024-08-07)
        - Updated for Kodi 21 (Omega) compatibility
        - Migrated to new addon ID (script.flatscan.widgets)
        - Removed obsolete Python 2 compatibility code
        - Restructured for modular development
        </news>
    </extension>
</addon>